class Solution {
    public String longestPalindrome(String s) {
        int n=s.length();
        int ans=0;
        int start=0;
        for(int i=0;i<n;i++){

        
        int l=i,r=i;
        while(l>=0&&r<n&&s.charAt(l)==s.charAt(r)){
            l--;
            r++;

        }
        int len=r-l-1;
        if(len>ans){
            ans=len;
            start=l+1;
        }
        l=i;
        r=i+1;
        while(l>=0&&r<n&&s.charAt(l)==s.charAt(r)){
            l--;
            r++;

        }
         len=r-l-1;
        if(len>ans){
            ans=len;
            start=l+1;
        }
        
        
        }

        return s.substring(start,start+ans);


    }
}
