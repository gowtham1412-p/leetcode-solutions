class Solution {
    public int countstring(String s,int i,int j){
        int n=s.length();
        int count=0;
        while(i>=0 && j<n && s.charAt(i)==s.charAt(j)){
            count++;
            i--;
            j++;
        }
        return count;
    }
    public int countSubstrings(String s) {
        int n=s.length();
        int ans=0;
        for(int i=0;i<n;i++){
            int odd=countstring(s,i,i);
            int even=countstring(s,i,i+1);
            ans+=odd+even;
        }
        return ans;

    }
}



