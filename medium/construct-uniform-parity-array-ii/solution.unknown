1class Solution {
2    public String toLowerCase(String s) {
3        int n=s.length();
4        String a="";
5        for(int i=0;i<n;i++){
6            char ch=s.charAt(i);
7            if(ch>='A'&& ch<='Z'){
8                ch=(char)(ch+32);
9            }
10                a+=ch;
11        }
12        return a;
13    }
14}