class Solution {
    public int countHomogenous(String s) {
        int n=s.length();
        long ans=0;
        long count=1;
        long mod=1000000007;
        for(int i=0;i<n-1;i++){
            if(s.charAt(i)==s.charAt(i+1)){
                count++;
            }else{
                ans+=(((count*(count+1))/2)%mod)%mod;
                count=1;
            }
        }
        ans+=(((count*(count+1))/2)%mod)%mod;
        return (int)ans;
        
    }
}
