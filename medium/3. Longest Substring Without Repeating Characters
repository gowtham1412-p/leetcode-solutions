class Solution {
    public int lengthOfLongestSubstring(String s) {
         int n=s.length();
         int max=0;
         Map<Character,Integer> map=new HashMap<>();
         int l=0;
         for(int r=0;r<n;r++){
            char c=s.charAt(r);
            map.put(c,map.getOrDefault(c,0)+1);
            while(map.get(c)>1){
                char cleft=s.charAt(l);
                map.put(cleft,map.get(cleft)-1);
                l++;
            }
            max=Math.max(max,r-l+1);
         }
         return max;
    }
}
