class Solution {
    public int peakValleyDifference(int[] nums) {
        int n=nums.length;
        
         List<Integer> list1=new ArrayList<>();
         List<Integer> list2=new ArrayList<>();
        for(int i=1;i<n-1;i++){
            if(nums[i]>nums[i-1]&&nums[i]>nums[i+1]){
                list1.add(nums[i]);
            }else if(nums[i]<nums[i-1]&&nums[i]<nums[i+1]){
                list2.add(nums[i]);
            }
        }
        int sum1=0;
        for(int num:list1){
            sum1+=num;
        }
        int sum2=0;
        for(int num:list2){
            sum2+=num;
        }
        return sum1-sum2;
    }
}©leetcode
