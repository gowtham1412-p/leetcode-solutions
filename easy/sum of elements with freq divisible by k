class Solution {
    public int sumDivisibleByK(int[] nums, int k) {
        int sum=0;
        int n=nums.length;
        int count[]=new int[101];
        for(int i=0;i<n;i++){
            count[nums[i]]++;
            
        }

        for(int i=0;i<count.length;i++){
             if(count[i]%k==0){
                   sum+=count[i]*i;
             }
             
        }
        return sum;
    }
}
